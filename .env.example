# Per-user credentials for this project's AI-SDLC MCP servers (in mcp.json).
# Copy this file to `.env` in this pipeline repo root and fill in your OWN values.
# `.env` is gitignored — never commit real credentials.
#
# The pipeline loads this repo's `.env` into its environment before spawning
# agents, so ${VAR} placeholders in mcp.json resolve from these values.

# MongoDB connection string. Used by mongodb-mcp-server (per-stage MCP) AND by
# the deterministic `npm run sdlc fetch <uploadJobId>` command (via the mongodb
# driver). Reuse the same connection string; a read-only user is recommended.
# Example: mongodb+srv://<user>:<pass>@<cluster>/<db>?readPreference=secondary
MONGODB_URI=

# Sentry API token for the `fetch` command's Sentry REST calls. Create a Sentry
# User Auth Token (sntryu_...) at https://sentry.io/settings/account/api/auth-tokens/
# OR an Internal Integration token (sntrys_...) under your org's Developer
# Settings, with scopes: event:read, project:read, org:read.
# (Do NOT use an Organization Auth Token sntryo_... — it lacks event:read.)
SENTRY_AUTH_TOKEN=
# (The fetch also downloads the job's error screenshot from its Sentry event
# attachments using this same token — no S3 or extra credentials needed.)
